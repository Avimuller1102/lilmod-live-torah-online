# LILMOD Website Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# FORMSPREE CONFIGURATION
# =============================================================================
# 
# To get your Formspree ID:
# 1. Go to https://formspree.io and create a free account
# 2. Create a new form
# 3. Add email addresses: avimuller1102@gmail.com and aaronbotbol@gmail.com
# 4. Copy the form ID from the form endpoint URL (e.g., "xyzabcde")
# 5. Paste it below
#
VITE_FORMSPREE_ID=YOUR_FORMSPREE_ID_HERE

# =============================================================================
# YOUTUBE CONFIGURATION
# =============================================================================
# Optional. If empty, the site displays curated fallback videos.
# Create a restricted YouTube Data API v3 key in Google Cloud and restrict it
# to your deployment domains.
#
VITE_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# =============================================================================
# SPOTIFY SERVERLESS CONFIGURATION
# =============================================================================
# Only set these in Netlify environment variables, not in browser code.
# They allow the Netlify function to fetch the latest episodes.
#
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE
